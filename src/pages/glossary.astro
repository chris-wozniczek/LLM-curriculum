---
import Base from "../layouts/Base.astro";
import { glossary } from "../data/glossary";
import { bySlug } from "../data/curriculum";
const sorted = [...glossary].sort((a, b) => a.t.localeCompare(b.t, "en", { sensitivity: "base" }));
---
<Base title="Glossary" description="Every term in the curriculum in one or two plain sentences.">
  <section class="wrap" style="max-width:860px;padding-top:70px">
    <span class="eyebrow">Glossary</span>
    <h1 class="display" style="font-size:clamp(44px,6vw,72px)">Every term, <em>plainly</em>.</h1>
    <p class="lede">Hover any dotted word in a lesson to see its entry. {glossary.length} terms so far.</p>
    <dl class="gl">
      {sorted.map((g) => (
        <div id={g.k} class="gl-row">
          <dt>{g.t}</dt>
          <dd>{g.d}{g.m && bySlug[g.m] && <> <a href={`/learn/${g.m}`} class="mono">→ {bySlug[g.m].title}</a></>}</dd>
        </div>
      ))}
    </dl>
  </section>
</Base>
<style>
  .gl { margin-top: 40px; }
  .gl-row { display: grid; grid-template-columns: 220px 1fr; gap: 20px; padding: 16px 0; border-bottom: 1px solid var(--line); scroll-margin-top: 90px; }
  .gl-row:target { background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 10%, transparent), transparent); }
  dt { font-weight: 600; }
  dd { margin: 0; color: var(--ink-2); }
  dd a { font-size: 12px; color: var(--accent); text-decoration: none; margin-left: 4px; }
  @media (max-width: 640px) { .gl-row { grid-template-columns: 1fr; gap: 4px; } }
</style>
