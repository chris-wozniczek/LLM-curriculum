---
import Fig from "../Fig.astro";
import R from "../../data/qwen3-inside.json";
const next = (R as any).next as any[];
---
<Fig title="Sampling: temperature, top-k, top-p, min-p" sub="real Qwen3-0.6B logits for the 40 most likely next tokens">
  <script type="application/json" id="sp-data" set:html={JSON.stringify(next)} />
  <div class="row"><div class="seg" id="sp-p">{next.map((n, i) => <button data-i={i} class={i === 1 ? "on" : ""}>{JSON.stringify(n.prompt).slice(1, 30)}</button>)}</div></div>
  <div class="sp-ctl">
    <label class="field">temperature <b id="sp-tv"></b><input type="range" id="sp-t" min="0.05" max="2" step="0.05" value="1" /></label>
    <label class="field">top-k <b id="sp-kv"></b><input type="range" id="sp-k" min="1" max="40" step="1" value="40" /></label>
    <label class="field">top-p <b id="sp-pv"></b><input type="range" id="sp-pp" min="0.05" max="1" step="0.05" value="1" /></label>
    <label class="field">min-p <b id="sp-mv"></b><input type="range" id="sp-m" min="0" max="0.5" step="0.01" value="0" /></label>
  </div>
  <div id="sp-bars"></div>
  <Fragment slot="cap">Logits measured with <code>labs/inside_qwen.py</code>. To keep the page light only the top 40 of 151,936 tokens are stored, so probabilities here are renormalized over those 40 (with temperature 1 they cover most of the mass for these prompts). Order applied: temperature, then top-k, top-p and min-p, then renormalize. Faded bars are tokens that can no longer be sampled.</Fragment>
</Fig>
<style>
  .sp-ctl { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 12px; margin: 14px 0; }
  .sp-ctl .field { display: grid; gap: 6px; } .sp-ctl b { color: var(--accent); font-family: var(--mono); }
  #sp-bars { display: grid; gap: 3px; font: 500 12px/1 var(--mono); }
  .sp-r { display: grid; grid-template-columns: 110px 1fr 56px; gap: 10px; align-items: center; transition: opacity .2s; }
  .sp-r.off { opacity: .25; } .sp-r span:first-child { white-space: pre; overflow: hidden; text-overflow: ellipsis; text-align: right; color: var(--ink-2); }
  .sp-b { height: 10px; border-radius: 5px; background: rgba(255,255,255,.05); } .sp-b i { display: block; height: 100%; border-radius: 5px; background: var(--accent); transition: width .25s var(--ease); }
  .sp-r span:last-child { text-align: right; }
</style>
<script>
  const N = JSON.parse(document.getElementById("sp-data")!.textContent!);
  let pi = 1;
  const g = (id: string) => document.getElementById(id) as HTMLInputElement;
  function draw() {
    const n = N[pi], T = +g("sp-t").value, K = +g("sp-k").value, P = +g("sp-pp").value, MP = +g("sp-m").value;
    g("sp-tv").textContent = T.toFixed(2); g("sp-kv").textContent = String(K); g("sp-pv").textContent = P.toFixed(2); g("sp-mv").textContent = MP.toFixed(2);
    const z = n.logits.map((l: number) => l / T), mx = Math.max(...z), e = z.map((v: number) => Math.exp(v - mx)), S = e.reduce((a: number, b: number) => a + b, 0);
    const p = e.map((v: number) => v / S);
    let cum = 0;
    const keep = p.map((v: number, i: number) => { const ok = i < K && cum < P && v >= MP * p[0]; cum += v; return ok; });
    const S2 = p.reduce((a: number, v: number, i: number) => a + (keep[i] ? v : 0), 0);
    const show = n.tokens.slice(0, 16);
    document.getElementById("sp-bars")!.innerHTML = show.map((t: string, i: number) => { const q = keep[i] ? p[i] / S2 : 0; return `<div class="sp-r ${keep[i] ? "" : "off"}"><span>${JSON.stringify(t).slice(1, -1).replace(/</g, "&lt;")}</span><div class="sp-b"><i style="width:${(keep[i] ? q : p[i]) * 100}%"></i></div><span>${(q * 100).toFixed(1)}%</span></div>`; }).join("");
  }
  document.querySelectorAll<HTMLButtonElement>("#sp-p button").forEach((b) => b.addEventListener("click", () => { document.querySelectorAll("#sp-p button").forEach((y) => y.classList.remove("on")); b.classList.add("on"); pi = +b.dataset.i!; draw(); }));
  ["sp-t", "sp-k", "sp-pp", "sp-m"].forEach((id) => g(id).addEventListener("input", draw)); draw();
</script>
