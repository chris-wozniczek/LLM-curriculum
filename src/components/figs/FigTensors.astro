---
import Fig from "../Fig.astro";
import data from "../../data/qwen3-0.6b-tensors.json";
const kind = (n: string) =>
  n.includes("embed_tokens") ? "embedding" : n.startsWith("lm_head") ? "lm_head" : /norm/.test(n) ? "norms" :
  /self_attn\.(q|k|v|o)_proj/.test(n) ? "attention" : /mlp\./.test(n) ? "mlp" : "other";
const rows = data.tensors.map((t: any) => ({ ...t, kind: kind(t.name), layer: +(t.name.match(/layers\.(\d+)\./)?.[1] ?? -1) }))
  .sort((a: any, b: any) => a.layer - b.layer || a.name.localeCompare(b.name));
const kinds = ["embedding", "attention", "mlp", "norms", "lm_head"];
const totals = Object.fromEntries(kinds.map((k) => [k, rows.filter((r: any) => r.kind === k).reduce((a: number, r: any) => a + r.params, 0)]));
const colors: Record<string, string> = { embedding: "var(--violet)", attention: "var(--blue)", mlp: "var(--amber)", norms: "var(--led)", lm_head: "var(--pink)" };
const all = data.params;
const fmt = (n: number) => n.toLocaleString("en-US");
---
<Fig title="Every tensor in Qwen3-0.6B" sub={`${data.tensors.length} tensors · header ${fmt(data.header_bytes)} bytes · read from model.safetensors`}>
  <div class="tb-bar">{kinds.map((k) => <div style={`flex:${totals[k]};background:${colors[k]}`} title={k}></div>)}</div>
  <div class="tb-leg">{kinds.map((k) => <button data-k={k}><i style={`background:${colors[k]}`}></i>{k}<b>{(totals[k] / all * 100).toFixed(1)}%</b><small>{fmt(totals[k])}</small></button>)}</div>
  <div class="row" style="margin:14px 0 10px">
    <label class="field">filter <input type="text" id="tn-q" placeholder="e.g. layers.0. or q_proj" style="width:220px" /></label>
    <span class="mono dim" id="tn-n" style="font-size:12px"></span>
  </div>
  <div class="scroll-x tn-box">
    <table class="tbl"><thead><tr><th>name</th><th>dtype</th><th>shape</th><th class="r">numbers</th></tr></thead>
    <tbody id="tn-rows">{rows.map((r: any) => <tr data-n={r.name} data-k={r.kind}><td><i class="dot" style={`background:${colors[r.kind]}`}></i>{r.name}</td><td>{r.dtype}</td><td>[{r.shape.join(", ")}]</td><td class="r">{fmt(r.params)}</td></tr>)}</tbody></table>
  </div>
  <Fragment slot="cap">Shares are of all {fmt(all)} numbers stored in the file. The file stores <code>lm_head.weight</code> as its own tensor even though <code>config.json</code> says <code>tie_word_embeddings: true</code>, so the loader ends up using one matrix for both. Count it once and you get {fmt(all - totals.lm_head)}, the "0.6B" in the name. Generated by <code>labs/inspect_safetensors.py</code>.</Fragment>
</Fig>
<style>
  .tb-bar { display: flex; height: 16px; border-radius: 8px; overflow: hidden; gap: 2px; }
  .tb-bar div { min-width: 3px; }
  .tb-leg { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .tb-leg button { display: flex; align-items: center; gap: 7px; padding: 7px 10px; border-radius: 10px; border: 1px solid var(--line); background: rgba(255,255,255,.03); font: 500 12px/1 var(--mono); cursor: pointer; color: var(--ink-2); }
  .tb-leg button:hover, .tb-leg button.on { border-color: var(--line-2); color: var(--ink); }
  .tb-leg i, .dot { width: 8px; height: 8px; border-radius: 2px; display: inline-block; }
  .dot { margin-right: 8px; }
  .tb-leg b { color: var(--ink); }
  .tb-leg small { color: var(--ink-3); }
  .tn-box { max-height: 360px; overflow-y: auto; border: 1px solid var(--line); border-radius: 12px; }
  .tn-box thead th { position: sticky; top: 0; background: #11141b; }
</style>
<script>
  const q = document.getElementById("tn-q") as HTMLInputElement, rows = [...document.querySelectorAll<HTMLTableRowElement>("#tn-rows tr")], n = document.getElementById("tn-n")!;
  let k = "";
  const apply = () => { let c = 0; rows.forEach((r) => { const ok = r.dataset.n!.includes(q.value.trim()) && (!k || r.dataset.k === k); r.style.display = ok ? "" : "none"; c += +ok; }); n.textContent = `${c} shown`; };
  q.addEventListener("input", apply);
  document.querySelectorAll<HTMLButtonElement>(".tb-leg button").forEach((b) => b.addEventListener("click", () => {
    k = k === b.dataset.k ? "" : b.dataset.k!; document.querySelectorAll(".tb-leg button").forEach((x) => x.classList.toggle("on", (x as HTMLElement).dataset.k === k)); apply();
  }));
  q.value = "layers.0."; apply();
</script>
